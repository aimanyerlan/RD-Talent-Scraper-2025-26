DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost,web
DJANGO_LOG_DIR=/app/logs
LOG_LEVEL=INFO

POSTGRES_DB=talent_db
POSTGRES_USER=talent_user
POSTGRES_PASSWORD=talent_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
# Optional: managed Postgres (e.g. Render) — when set, overrides POSTGRES_* above
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL_REQUIRE=true

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
SKIP_DJANGO_MIGRATE=0

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
USE_X_FORWARDED_HOST=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
JWT_AUTH_HTTPONLY=True
JWT_AUTH_SECURE=False
JWT_AUTH_SAMESITE=Lax
JWT_RETURN_IN_BODY=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

ENABLE_PROMETHEUS=True
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
WEB_CONCURRENCY=3

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Optional AI summary for vacancy detail page (set real keys only in .env, not committed)
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
