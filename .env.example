# --- Core Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_DIR=/app/logs
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_DB=talent_db
POSTGRES_USER=talent_user
POSTGRES_PASSWORD=talent_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
SKIP_DJANGO_MIGRATE=0

# --- HTTP / CORS / CSRF (production: use real domains) ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
USE_X_FORWARDED_HOST=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Prometheus (Gunicorn multi-worker) ---
ENABLE_PROMETHEUS=True
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
WEB_CONCURRENCY=3

# --- Grafana (docker compose --profile monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Email (optional) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
